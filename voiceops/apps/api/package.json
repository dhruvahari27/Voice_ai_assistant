{
  "name": "@voiceops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:reset": "tsx scripts/reset.ts",
    "eval": "tsx eval/run.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@voiceops/shared": "workspace:*",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.23.1",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.2",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
