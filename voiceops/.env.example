# Optional. VoiceOps runs with no .env at all: built-in database, built-in receptionist,
# messages shown in the dashboard instead of sent. Copy to .env only to change something.

# --- Server ---
# API_PORT=4000
# WEB_ORIGIN=http://localhost:5173
# LOG_LEVEL=info

# --- Database ---
# Empty = built-in Postgres stored in apps/api/.data (nothing to install).
# Set a postgres:// URL to use a real Postgres server instead (recommended in production).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiceops

# --- Security (MUST be set to long random strings in production) ---
# SESSION_SECRET=
# AGENT_SERVICE_TOKEN=

# --- Demo data ---
# SEED_DEMO_HISTORY=true   # 4 weeks of sample calls on first start (removable in Settings)
# DEMO_LOGIN=true          # "Try the demo" on the sign-in page (default: on, except NODE_ENV=production)
# SIGNUP_ENABLED=true      # let new businesses create an account from the sign-in page

# --- Optional AI model for the receptionist (any OpenAI-compatible API) ---
# Without it, the built-in rules engine handles every call.
# Groq (free tier):  LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.3-70b-versatile
# Gemini:            LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   LLM_MODEL=gemini-2.0-flash
# OpenAI:            LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# --- Optional WhatsApp Cloud API (Meta) ---
# Without these, messages appear on the Messages page marked "Not sent".
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# --- Phone agent (apps/agent, Python) ---
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# VOICEOPS_API_URL=http://localhost:4000
# BUSINESS_SLUG=autocare
# AGENT_STT=sarvam          # sarvam | deepgram
# AGENT_TTS=sarvam          # sarvam | elevenlabs
# AGENT_LANGUAGE=hi-IN      # hi-IN understands Hinglish; en-IN for English callers
# AGENT_ENGINE=rules        # rules | llm
# SARVAM_API_KEY=
# DEEPGRAM_API_KEY=
# ELEVEN_API_KEY=
