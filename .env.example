# Copy to .env and fill in. Never commit .env.

# --- Core ---
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiceops
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/voiceops_test
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Token the Python agent uses to call /api/v1/tools/* (Phase 2)
AGENT_SERVICE_TOKEN=change-me-to-a-long-random-string

# --- LiveKit (Phase 1) — India region project ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Speech + LLM (Phase 1) ---
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
LLM_API_KEY=

# --- Messaging (Phase 5) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
SMS_PROVIDER_API_KEY=
